# ========================================================
# Ingress Within — Production Environment Configuration
# ========================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=
# JWT Session Authentication
JWT_SECRET=generate_a_secure_64_character_hex_string

# Journal Entry Encryption (AES-256-GCM, 32-byte key as 64-char hex string)
ENCRYPTION_MASTER_KEY=generate_a_64_character_hex_string_here

# MSG91 Phone OTP Authentication
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id
MSG91_SENDER_ID=INGWRT

# AI Providers (Claude Primary + Groq Failover + Gemini Knowledge Engine)
AI_PROVIDER=claude
CLAUDE_API_KEY=your_anthropic_claude_api_key
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Background Processing & Scheduling
BYPASS_REDIS=true
CRON_SECRET=generate_a_secure_cron_secret_here

# ========================================================
# Transactional Email System (MSG91 Email API v5 + BullMQ / In-Process)
# Docs: https://docs.msg91.com/email
# ========================================================
EMAIL_PROVIDER=msg91

# MSG91 Email Authentication Key (Defaults to MSG91_AUTH_KEY if not specified)
# Keep server-side only; never expose to client bundles.
MSG91_EMAIL_AUTH_KEY=your_msg91_auth_key

# Approved and Verified Sending Domain in MSG91 Panel
MSG91_EMAIL_DOMAIN=ingresswithin.com

# Single Reusable MSG91 Email Template ID
# Configure ONE template in your MSG91 Email Dashboard:
# - Template Name: "Ingress Within Transactional Base"
# - Subject Field: {{subject}}
# - Body Field: {{{body_html}}}
# All 15+ transactional email events render their complete, responsive, branded layout
# within the application and dispatch through this single provider template.
MSG91_EMAIL_TEMPLATE_ID=your_single_reusable_email_template_id
MSG91_EMAIL_DEFAULT_TEMPLATE_ID=your_single_reusable_email_template_id

# Verified Sender and From Address
EMAIL_FROM=contactus@ingresswithin.com
EMAIL_FROM_NAME=Ingress Within

# Support and Reply-To Address
EMAIL_REPLY_TO=contactus@ingresswithin.com

# Authoritative notification email recipients
THERAPIST_APPLICATION_NOTIFICATION_EMAIL=contactus@ingresswithin.com
OPS_TEAM_EMAIL=contactus@ingresswithin.com

# MSG91 Webhook Secret / Header Token (Configured in MSG91 Webhook Headers -> x-webhook-secret)
# Used to verify incoming delivery reports at /api/webhooks/email
MSG91_WEBHOOK_SECRET=your_msg91_webhook_secret_key
EMAIL_WEBHOOK_SECRET=your_msg91_webhook_secret_key

# Email Dispatch Mode: "queue" | "immediate"
# Set to "immediate" for Vercel/Serverless deployment or when running without a persistent Redis worker daemon.
# Set to "queue" when running with BullMQ and persistent worker daemon ('npm run worker').
EMAIL_DISPATCH_MODE=immediate

# Development / Mock override: strictly for offline local test environments without live MSG91 credentials.
# In production, this must remain false or unset so missing credentials fail explicitly.
ALLOW_MOCK_EMAIL=false

# Legacy Fallback Provider (Optional, during migration transition window only)
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_PLAN_ID=plan_your_plan_id

# Google Calendar & Meet Integration
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://ingresswithin.com/api/calendar/google/callback
